@model List<Microsoft.Graph.DriveItem>;
@using HFA.Resources;
@{
    bool isEven = true;
    ViewData["Title"] = HFA_Resources.FileManagement;

}
<div class="m-auto">
    <section class="min-h-screen bg-gray-100 px-16 py-4 md:px-36">
        <h1 class="w-fit pb-4 text-2xl text-secondary">@HFA_Resources.FileManagement</h1>
        <h3 class="w-fit pb-4 text-lg font-bold text-secondary">@(ViewBag.CurrentFolder != null && ViewBag.CurrentFolder != "root" ? ViewBag.CurrentFolder + " Folder - " : "")@Model.Count() @HFA_Resources.Files</h3>

        @if (Model.Count() == 0 || (ViewBag.ParentReference != null && (ViewBag.ParentReference.Name != "root" && ViewBag.CurrentFolder != "root")))
        {

            <div class="pb-4">
                <a asp-action="ViewSubFolderFiles" asp-controller="File" asp-route-folderId="@(Model.Count == 0?null:ViewBag.ParentReference.Id)" class="flex" title="View Sub-Folders and Files">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                        <path fill-rule="evenodd" d="M7.793 2.232a.75.75 0 0 1-.025 1.06L3.622 7.25h10.003a5.375 5.375 0 0 1 0 10.75H10.75a.75.75 0 0 1 0-1.5h2.875a3.875 3.875 0 0 0 0-7.75H3.622l4.146 3.957a.75.75 0 0 1-1.036 1.085l-5.5-5.25a.75.75 0 0 1 0-1.085l5.5-5.25a.75.75 0 0 1 1.06.025Z" clip-rule="evenodd" />
                    </svg>&nbsp;Back to @(Model.Count == 0 ? "Main " : ViewBag.ParentReference.Name) Folder
                </a>
            </div>

        }
        <div class="mb-4 flex justify-end">
            <form asp-action="Search" asp-controller="File">
                <input type="text" name="searchValue" class="bg-white-100 max-w-s col-span-3 m-4 rounded-md border border-solid border-secondary p-1.5 md:col-span-2" />
                <button type="submit" class="btn bg-accent">@HFA_Resources.Search</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="table">
                <thead class="bg-accent">
                    <tr>
                        <th></th>
                        <th>@HFA_Resources.FileNameHeader</th>
                        <th>@HFA_Resources.FileDateModifiedHeader</th>
                        <th>@HFA_Resources.FileModifiedByHeader</th>
                        <th>@HFA_Resources.FileTypeHeader</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var file in Model)
                    {
                        <tr class="@(isEven ? "bg-base-100" : "bg-base-200")">
                            <td>
                                <a href="@file.WebUrl" target="_blank" title="@file.WebUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="@(file.File != null ?"none":"")" viewBox="0 0 24 24" stroke-width="@(file.File != null ? "1.5" : "")" stroke="@(file.File != null ? "currentColor" : "")" class="h-6 w-6">
                                        <path stroke-linecap="@(file.File != null ?"round":"")" stroke-linejoin="@(file.File != null ?"round":"")" d="@(file.File != null ? "M3 3.5A1.5 1.5 0 0 1 4.5 2h6.879a1.5 1.5 0 0 1 1.06.44l4.122 4.12A1.5 1.5 0 0 1 17 7.622V16.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 16.5v-13Z":"M3.75 3A1.75 1.75 0 0 0 2 4.75v3.26a3.235 3.235 0 0 1 1.75-.51h12.5c.644 0 1.245.188 1.75.51V6.75A1.75 1.75 0 0 0 16.25 5h-4.836a.25.25 0 0 1-.177-.073L9.823 3.513A1.75 1.75 0 0 0 8.586 3H3.75ZM3.75 9A1.75 1.75 0 0 0 2 10.75v4.5c0 .966.784 1.75 1.75 1.75h12.5A1.75 1.75 0 0 0 18 15.25v-4.5A1.75 1.75 0 0 0 16.25 9H3.75Z")" />
                                    </svg>
                                </a>
                            </td>

                            <td>
                                @if (file.File == null)
                                {
                                    <a asp-action="ViewSubFolderFiles" asp-controller="File" asp-route-folderId="@file.Id">
                                        @file.Name
                                    </a>
                                }
                                else
                                {
                                    <a href="@file.WebUrl" target="_blank">@file.Name</a>

                                }
                            </td>
                            <td>@(HFA_Resources.Culture == null || HFA_Resources.Culture.ToString() != "fr-CA" ? @file.LastModifiedDateTime.Value.ToString("dddd, MMMM d, yyyy") : @file.LastModifiedDateTime.Value.ToString("dddd, d MMMM yyyy", HFA_Resources.Culture))</td>
                            <td>@file.LastModifiedBy.User.DisplayName</td>
                            <td>@(file.File != null ? Files.GetFileType(file.File.MimeType) : "Folder")</td>
                        </tr>
                        isEven = !isEven;
                    }
                </tbody>
            </table>
            @if (Model.Count() == 0)
            {
                <p class="text-center text-sm">No results found.</p>
            }
        </div>
    </section>
</div>