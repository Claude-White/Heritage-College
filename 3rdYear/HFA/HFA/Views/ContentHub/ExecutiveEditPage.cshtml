@using System.Reflection
@using System.ComponentModel.DataAnnotations
@using HFA.Attributes
@using HFA.Resources
@model Executive

@{
    ViewData["Title"] = "Edit/Add an Executive";
    Layout = "~/Views/Shared/_ContentHubLayout.cshtml";
    var RESTResources = new RESTResources(
        "CreateExecutive",
        "UpdateExecutive",
        "DeleteExecutive"
    );
}

<div id="RESTResources" data-resources='@Html.Raw(Json.Serialize(RESTResources))'></div>

<form id="form" class="flex w-full flex-col gap-4">
    <input asp-for="ExecutiveId" id="ObjectId" type="hidden"/>
    <div class="flex">
        <h1 class="mt-3 text-3xl font-bold">@HFA_Resources.Executive</h1>
        <div class="ml-auto mr-0 flex w-fit gap-2">
            <a class="btn" asp-controller="ContentHub" asp-action="Executives">Back</a>
            <button id="@ViewBag.Action" type="submit" class="btn btn-success" title="Save">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                Save
            </button>
        </div>
    </div>


    <div class="flex justify-between">

        <label class="form-control w-full lg:w-1/2">
            <div class="label">
                <span class="label-text font-bold">First Name</span>
            </div>
            <input asp-for="FirstName" id="fnameInput" class="input input-bordered w-full" placeholder="Enter the first name here" />
        </label>
    </div>
    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Last Name</span>
        </div>
        <input asp-for="LastName" id="lnameInput" class="input input-bordered w-full" placeholder="Enter the last name here" />
    </label>
    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Email</span>
        </div>
        <input asp-for="Email" id="emailInput" class="input input-bordered w-full" placeholder="Enter the email here" />
    </label>

    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Position</span>
        </div>
        <input asp-for="Position" id="positionInput" class="input input-bordered w-full" placeholder="Enter the HFA position here" />
    </label>

    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Description</span>
        </div>
        <input asp-for="Description" id="descriptionInput" class="input input-bordered w-full" placeholder="Enter the description here" />
    </label>
</form>

<script type="module" src="~/js/EditPageController.js"></script>