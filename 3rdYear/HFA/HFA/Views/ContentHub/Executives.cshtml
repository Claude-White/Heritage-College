@using HFA.Models;
@using System.Collections;
@using HFA.Resources;
@using HFA.Models.ViewModels;
@model IEnumerable

@{
    Layout = "~/Views/Shared/_ContentHubLayout.cshtml";
    ViewData["Title"] = HFA_Resources.ExecutivesLabel;

    @* Config *@
    var PageName = HFA_Resources.ExecutivesLabel;
    var TemplateModel = new ExecutiveViewModel();
    var RESTResources = new RESTResources(
        "Executives/CreateExecutive",
        "Executives/CreateExecutive",
        "Executives/DeleteExecutive"
    );
    var AreRowsSummary = true;
}

<partial name="_EntriesPage" model="new EntryPage(Model,PageName,TemplateModel,RESTResources,AreRowsSummary)" />