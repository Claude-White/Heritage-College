@using System.Reflection
@using System.ComponentModel.DataAnnotations
@using HFA.Attributes
@using HFA.Resources
@model ReleaseNotes

@{
    ViewData["Title"] = "Edit/Add a Release Note";
    Layout = "~/Views/Shared/_ContentHubLayout.cshtml";
    var RESTResources = new RESTResources(
        "CreateReleaseNote",
        "UpdateReleaseNote",
        "DeleteReleaseNote"
    );
}

<div id="RESTResources" data-resources='@Html.Raw(Json.Serialize(RESTResources))'></div>

<form id="form" class="flex w-full flex-col gap-4">
    @Html.AntiForgeryToken()
    <input asp-for="ReleaseNoteId" id="ObjectId" type="hidden" />
    <div class="flex">
        <h1 class="mt-3 text-3xl font-bold">@HFA_Resources.ReleaseNotes</h1>
        <div class="ml-auto mr-0 flex w-fit gap-2">
            <a class="btn" asp-controller="ContentHub" asp-action="ReleaseNotes">Back</a>
            <button id="@ViewBag.Action" type="submit" class="btn btn-success" title="Save">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                Save
            </button>
        </div>
    </div>


    <div class="flex justify-between">

        <label class="form-control w-full lg:w-1/2">
            <div class="label">
                <span class="label-text font-bold">Title</span>
            </div>
            <input asp-for="Title" id="titleInput" class="input input-bordered w-full" placeholder="Enter the title here" />
        </label>
    </div>
    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Version Number (#.#.#)</span>
        </div>
        <input asp-for="ReleaseVersion" id="releaseversionInput" class="input input-bordered w-full" placeholder="Enter the version number here" />
    </label>

    <label class="form-control w-full lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Short Summary</span>
        </div>
        <textarea asp-for="ShortSummary" id="shortsummaryInput" class="input input-bordered min-h-[120px] w-full resize-none pt-1" placeholder="Enter the summary here"></textarea>
    </label>

    <label class="form-control w-full">
        <div class="label">
            <span class="label-text font-bold">Content</span>
        </div>
        <textarea asp-for="Content" id="content-text-area" class="textarea textarea-bordered"></textarea>
    </label>
</form>

<script type="module" src="~/js/EditPageController.js"></script>