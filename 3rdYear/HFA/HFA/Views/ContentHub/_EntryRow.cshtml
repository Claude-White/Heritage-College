@using System.Reflection
@using System.ComponentModel.DataAnnotations
@model Tuple<dynamic, bool, bool, string>

@{
    var RowModel = Model.Item1;
    var isTemplate = Model.Item2;
    var IsSummary = Model.Item3;
    var isRawDisplay = Model.Item4;

    Type modelType = RowModel.GetType();
    PropertyInfo[] properties = modelType.GetProperties();

    var KeyProperty = properties.FirstOrDefault(p => p.GetCustomAttributes(typeof(KeyAttribute), true).Any());
    var KeyValue = KeyProperty != null ? KeyProperty.GetValue(RowModel, null) : null;
}

<tr class="content-row h-full bg-base-100" @(isTemplate ? " style=display:none; id=EntryTemplate" : "")>
    <th class="w-16">
        <button class="action-move" style="display: none;" aria-label="Move" title="Move">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" opacity="0.5" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
        </button>

        @if (KeyProperty != null)
        {
            <input type="hidden" @(IsSummary ? " readonly" : "") data-index="@KeyProperty.Name" value="@KeyValue" isId="true" />
        }
    </th>

    @foreach (PropertyInfo property in properties)
    {
        var value = property.GetValue(RowModel, null);
        var isKey = Attribute.IsDefined(property, typeof(KeyAttribute));
        Type propertyType = property.PropertyType;
        if (!isKey)
        {
            <td>
                @if (propertyType == typeof(bool))
                {
                    <input type="text" @(IsSummary ? " readonly" : "") data-index="@property.Name" placeholder="@property.Name" value='@value' class="input input-ghost text-md w-full">

                } else
                {
                    @if (isRawDisplay != "" && isRawDisplay == property.Name)
                    {
                        <textarea @(IsSummary ? " readonly" : "") data-index="@property.Name" placeholder="@property.Name" class="input input-ghost text-md textareaResize w-full resize-none">
                            @Html.Raw(value)
                        </textarea>
                    } else
                    {
                        <input type="text" @(IsSummary ? " readonly" : "") data-index="@property.Name" placeholder="@property.Name" value='@value' class="input input-ghost text-md w-full">
                    }
                    
                }
            </td>
        }
    }

    <td class="h-fit w-32 p-8">
        <div class="actions-container flex content-center items-center justify-end gap-2">
            @if (IsSummary && KeyProperty != null)
            {
                <a asp-route-id="@KeyValue" class="action-update" style="display: none;" aria-label="Update" title="Update">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" opacity="0.5">
                        <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                        <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                    </svg>
                </a>
            } else
            {
                <button class="action-confirm btn btn-primary btn-sm btn-square text-base-content" style="display: none;" aria-label="Confirm" title="Confirm">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <button class="action-cancel btn btn-outline btn-sm btn-square text-base-content" style="display: none;" aria-label="Cancel" title="Cancel">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                    </svg>
                </button>
            }
            <button class="action-delete" style="display: none;" aria-label="Delete" title="Delete">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" opacity="0.5">
                    <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    </td>
</tr>