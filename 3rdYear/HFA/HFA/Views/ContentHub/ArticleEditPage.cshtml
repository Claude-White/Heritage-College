@using System.Reflection;
@using System.ComponentModel.DataAnnotations;
@using HFA.Attributes;
@using HFA.Resources;
@model ArticleEditViewModel

@{
    Layout = "~/Views/Shared/_ContentHubLayout.cshtml";
    ViewData["Title"] = "Edit/Add an article";
    var RESTResources = new RESTResources(
        "CreateArticle",
        "UpdateArticle",
        "DeleteArticle"
    );
}
<div id="RESTResources" data-resources='@Html.Raw(Json.Serialize(RESTResources))'></div>

<partial name="_EditImageModalPartial" />

<form id="form" class="flex w-full flex-col gap-4" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Article.ArticleId" id="ObjectId" type="hidden" />
    <div class="flex">
        <h1 class="mt-3 text-3xl font-bold">@HFA_Resources.Article</h1>
        <div class="ml-auto mr-0 flex w-fit gap-2">
            <a class="btn" asp-controller="ContentHub" asp-action="Articles">Back</a>
            <button id="@ViewBag.Action" class="btn btn-success" title="Save">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                Save
            </button>

            <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-square" title="Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                    </svg>
                </div>
                <ul tabindex="0" class="dropdown-content z-[1] menu rounded-box my-2 w-52 bg-base-100 p-2 shadow">
                    <li>
                        <button id="article-save-and-publish">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" title="Save and Publish">
                                <path fill-rule="evenodd" d="M18 5.25a2.25 2.25 0 0 0-2.012-2.238A2.25 2.25 0 0 0 13.75 1h-1.5a2.25 2.25 0 0 0-2.238 2.012c-.875.092-1.6.686-1.884 1.488H11A2.5 2.5 0 0 1 13.5 7v7h2.25A2.25 2.25 0 0 0 18 11.75v-6.5ZM12.25 2.5a.75.75 0 0 0-.75.75v.25h3v-.25a.75.75 0 0 0-.75-.75h-1.5Z" clip-rule="evenodd" />
                                <path fill-rule="evenodd" d="M3 6a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H3Zm6.874 4.166a.75.75 0 1 0-1.248-.832l-2.493 3.739-.853-.853a.75.75 0 0 0-1.06 1.06l1.5 1.5a.75.75 0 0 0 1.154-.114l3-4.5Z" clip-rule="evenodd" />
                            </svg>
                            Save and Publish
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <label class="form-control lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Title</span>
        </div>
        <input asp-for="Article.Title" class="input input-bordered w-full" placeholder="Enter the title here" />
    </label>

    <label class="form-control lg:w-1/2">
        <div class="label">
            <span class="label-text font-bold">Lead</span>
        </div>
        <input asp-for="Article.Lead" class="input input-bordered w-full" placeholder="Enter the lead here" />
    </label>

    <label class="form-control w-1/2">
        <div class="label">
            <span class="label-text font-bold">Category</span>
        </div>
        <input asp-for="Article.Category" class="input input-bordered w-full" placeholder="Enter the category here" />
    </label>

    <label class="form-control w-1/2">
        <div class="label">
            <span class="label-text font-bold">@HFA_Resources.Publish</span>
        </div>
        <input asp-for="Article.IsPublished" class="peer sr-only">
        <div class="peer relative h-6 w-11 rounded-full bg-gray-200 after:content-[''] after:absolute after:top-0.5 after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-focus:ring-2 peer-focus:ring-secondary peer-checked:bg-[#e8a713] peer-checked:after:translate-x-full peer-checked:after:border-white rtl:peer-checked:after:-translate-x-full"></div>
    </label>

    <label class="form-control w-fit">
        <div class="label">
            <span class="label-text font-bold">Article Image</span>
        </div>
        <div class="flex">
            @* This should be in a partial view but i couldnt figure it out *@
            <div class="image-upload-container aspect-16/9 flex h-96 w-full gap-2">
                <input hidden asp-for="HeroImageId" class="image-id-input" />

                <div class="image-upload-input-container w-inherit relative float-left inline-block h-full overflow-auto rounded border border-dashed border-neutral-600 bg-neutral-50">
                    <div class="flex h-full w-full flex-col items-center justify-center" title="Upload an image">
                        <input type="file" accept="image/*" class="image-upload-input w-inherit h-inherit opacity-0 absolute float-left">

                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
                            <path fill-rule="evenodd" d="M11.47 2.47a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1-1.06 1.06l-3.22-3.22V16.5a.75.75 0 0 1-1.5 0V4.81L8.03 8.03a.75.75 0 0 1-1.06-1.06l4.5-4.5ZM3 15.75a.75.75 0 0 1 .75.75v2.25a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5V16.5a.75.75 0 0 1 1.5 0v2.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V16.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>
                        <h2 class="bold text-lg text-neutral-800">Upload an Image</h2>
                        <p class="text-sm text-neutral-600">Drag and drop files here</p>
                    </div>
                </div>
                <div class="image-upload-preview-container w-inherit relative float-left hidden h-full overflow-auto rounded border border-neutral-600 bg-neutral-50">
                    <button class="clear-image-button btn btn-ghost btn-square absolute float-right ml-2 mt-2" title="Clear image button">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                    <img class="image-upload-preview-image h-full w-full" src="~/images/fneeq-logo.png" alt="Image uploaded"/>
                </div>
            </div>
        </div>
    </label>

    <label class="form-control w-full">
        <div class="label">
            <span class="label-text font-bold">@HFA_Resources.Content</span>
        </div>
        <textarea asp-for="Article.ContentBody" id="content-text-area" class="textarea textarea-bordered" placeholder="Enter the content here"></textarea>
    </label>

    <div>
        @if (Model.Article != null && Model.Article.ArticleId != 0)
        {
            @if (Model.Article.CreatedDate.HasValue)
            {
                <label class="form-control w-full">
                    <div class="label">
                        <span class="label-text font-bold">@HFA_Resources.CreatedDate</span>
                    </div>
                    <p class="h-12 px-4 text-base">@Model.Article.CreatedDate.Value.ToString("f") @HFA_Resources.ByLower @Model.Article.Author<p />
                </label>
            }

            @if (Model.Article.LastModifiedDate.HasValue)
            {
                <label class="form-control w-full">
                    <div class="label">
                        <span class="label-text font-bold">@HFA_Resources.LastModifiedDate</span>
                    </div>
                    <p class="h-12 px-4 text-base">@Model.Article.LastModifiedDate.Value.ToString("f") @HFA_Resources.ByLower @Model.Article.MostRecentEditor<p />
                </label>
            }
        }
    </div>

    <div class="ml-auto mr-0 flex w-fit gap-2">
        <a class="btn" asp-controller="ContentHub" asp-action="Articles">Back</a>
        <button id="@ViewBag.Action" class="btn btn-success" title="Save">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            Save
        </button>
    </div>

    <input asp-for="Article.LastModifiedDate" type="hidden" />
    <input asp-for="Article.Author" type="hidden" />
    <input asp-for="Article.MostRecentEditor" type="hidden" />
    <input asp-for="Article.CreatedDate" type="hidden" />
</form>

@* Page Js *@
<script type="module" src="~/js/EditPageController.js"></script>