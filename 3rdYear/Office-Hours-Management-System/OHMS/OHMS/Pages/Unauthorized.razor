@page "/unauthorized"

<header class="bg-darkslate">
    <div class="mx-auto max-w-7xl px-6 py-4">
        <h3 class="text-center text-2xl font-bold text-red-error">Unauthorized</h3>
    </div>
</header>


<div class="border-gray-200 mx-auto max-w-[80%] rounded-lg border border-red-error bg-yellow-warning bg-opacity-75 p-6 shadow-md">
    <div class="mb-4">
        <p>You do not have permission to access this page.</p>
        <p>Please log in with an appropriate account.</p>
    </div>
    
    <a href="/login" class="rounded-lg bg-primary px-4 py-2 text-white hover:bg-secondary hover:focus:ring-2 hover:focus:ring-primary hover:focus:ring-opacity-75">Go to Login</a>
</div>