@page "/student/Calendar"
@using OHMS.Models
@inject AppConstants AppConstants
@inject HttpClient Http
@attribute [Authorize("Student")]

@{
    var businessDays = GetBusinessDays(DateTime.Today, 10)
        .Select(date => new
        {
            Date = date,
        })
        .ToList();
}

<header class="bg-primary text-center text-white">
    <div class="mx-auto max-w-7xl px-6 py-4">
        <h3 class="text-center text-2xl font-bold text-white">Your Appointments</h3>
    </div>
</header>

<div class="h-full overflow-y-auto">
    <div class="flex flex-col gap-2 p-2">
        @foreach (var day in businessDays)
        {
            <h2 class="text-xl font-bold text-primary">@day.Date.ToString("dddd, MMMM d")</h2>
            @if (Appointments != null && Appointments.Any())
            {
                var todayAppointments = Appointments.Where(a => a.StartDate.Date == day.Date.Date).ToList();
                @if (!todayAppointments.Any())
                {
                    <div class="text-blue-grey">No appointments</div>
                }
                @foreach (var appointment in todayAppointments)
                {
                    <div class="h-max w-full truncate rounded-lg border border-grey bg-white p-3 text-left shadow-md">
                        <h4 class="font-bold text-primary">@appointment.Title</h4>
                        <p class="text-blue-grey">@appointment.StartDate.ToString("h:mm tt") - @appointment.EndDate.ToString("h:mm tt")</p>
                        <p class="text-blue-grey">@appointment.Description</p>
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private List<Appointment> Appointments { get; set; } = new List<Appointment>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Hardcoded FOR NOW ******************************************
            var studentId = 3;
            Appointments = await Http.GetFromJsonAsync<List<Appointment>>($"{AppConstants.BASE_URL}api/Appointment/student/{studentId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching appointments: {ex.Message}");
        }
    }

    private List<DateTime> GetBusinessDays(DateTime startDate, int numberOfDays)
    {
        var businessDays = new List<DateTime>();
        var currentDate = startDate;

        while (businessDays.Count < numberOfDays)
        {
            if (currentDate.DayOfWeek != DayOfWeek.Saturday &&
                currentDate.DayOfWeek != DayOfWeek.Sunday)
            {
                businessDays.Add(currentDate);
            }

            currentDate = currentDate.AddDays(1);
        }

        return businessDays;
    }
}
