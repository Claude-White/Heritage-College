@page "/profile";
@using OHMS.Models
@attribute [Authorize]
@inject HIAAAStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Profile</PageTitle>

<header class="bg-primary text-center text-white">
    <div class="mx-auto max-w-7xl px-6 py-4">
        <h3 class="text-center text-2xl font-bold text-white">Profile</h3>
    </div>
</header>

<div class="flex h-full items-center justify-center">
    <div class="border-gray-200 w-max rounded-lg border bg-white p-6 shadow-md">
        <h3 class="mb-4 text-center text-lg font-bold text-primary">@userProfile.FirstName @userProfile.LastName's Profile</h3>
        <div class="space-y-4">
            <div>
                <label class="text-gray-700 block text-sm font-medium">First Name</label>
                <div class="border-gray-300 bg-gray-50 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm">
                    @userProfile.FirstName
                </div>
            </div>
            <div>
                <label class="text-gray-700 block text-sm font-medium">Last Name</label>
                <div class="border-gray-300 bg-gray-50 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm">
                    @userProfile.LastName
                </div>
            </div>
            <div>
                <label class="text-gray-700 block text-sm font-medium">Email</label>
                <div class="border-gray-300 bg-gray-50 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm">
                    @userProfile.Email
                </div>
            </div>
            <div>
                <label class="text-gray-700 block text-sm font-medium">Role</label>
                <div class="border-gray-300 bg-gray-50 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm">
                    @userProfile.Role
                </div>
            </div>
            <div>
                <button @onclick="Logout" class="w-full rounded-lg bg-red-error px-4 py-2 text-white hover:bg-red-700 focus:ring-2 focus:ring-red-500">
                    Logout
                </button>
            </div>
        </div>
    </div>
</div>


@code {

    // This currently stands as is solely because we do not have a fully functional
    // authentication and authorization system to use this will be reformatted later
    // on to not contain hardcoded values.

    private TempUser userProfile = new TempUser("", "", "", "");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState?.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var role = user.FindFirst(c => c.Type == ClaimTypes.Role)?.Value;

            if (role == "Student")
            {
                userProfile = new TempUser("John", "Doe", "student@cegep-heritage.qc.ca", role);
            } else if (role == "Teacher")
            {
                userProfile = new TempUser("Jane", "Doe", "teacher@cegep-heritage.qc.ca", role);
            } else
            {
                NavigationManager.NavigateTo("/unauthorized");
            }
        } else
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    // Log out modal
    private async Task Logout()
    {
        await AuthenticationStateProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }

    public class TempUser
    {
        public string FirstName { get; set; } = null!;
        public string LastName { get; set; } = null!;
        public string Email { get; set; } = null!;
        public string Role { get; set; } = null!;

        public TempUser(string firstName, string lastName, string email, string role)
        {
            this.FirstName = firstName;
            this.LastName = lastName;
            this.Email = email;
            this.Role = role;
        }
    }
}
