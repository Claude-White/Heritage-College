@page "/login"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject CookieStorageAccessor CookieStorageAccessor
@inject AppConstants AppConstants
@inject NavigationManager NavigationManager

@* 
    add the following to each page to specify the page they currently are on 
    simply change the contents of the <h3><h3> tag.
*@

<header class="bg-primary text-center text-white">
    <div class="mx-auto w-full px-6 py-4">
       <h3 class="text-center text-2xl font-bold text-white">Login</h3>
    </div>
</header>

<div class="h-full flex justify-center items-center">
    <div class="border-gray-200 w-max rounded-lg border bg-white p-6 shadow-md">
        <EditForm Model="user" OnSubmit="HandleLogin">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="user.Username" class="border-gray-300 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
            <label for="password">Password</label>
            <InputText id="password" @bind-Value="user.Password" type="password" class="border-gray-300 mt-1 block w-full rounded-lg border px-4 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
            <button type="submit" class="mt-4 w-full rounded-lg bg-primary px-4 py-2 font-semibold text-white hover:bg-secondary hover:focus:ring-2 hover:focus:ring-primary hover:focus:ring-opacity-75">Login</button>
        </EditForm>
    </div>
</div>


@code {

    class User {
        [Required]
        public string Username { get; set; }
        [Required]
        public string Password { get; set; }
    }

    public class TokenResponse {
        [JsonPropertyName("token")]
        public string Token { get; set; }
    }

    User user = new User();
    
    async Task HandleLogin() {
        var authenticateEndpoint = $"{AppConstants.BASE_URL}HIA3/REST/Authenticate?username={user.Username}&password={user.Password}";
        
        var authenticateResult = await Http.GetAsync(authenticateEndpoint);
        
        if (authenticateResult.IsSuccessStatusCode) {
            var authenticateResultContent = await authenticateResult.Content.ReadAsStringAsync();
            var jsonToken = JsonSerializer.Deserialize<TokenResponse>(authenticateResultContent);
            if (jsonToken is { Token: not null }) {
                await CookieStorageAccessor.SetValueAsync("token", jsonToken?.Token);

                var authorizeEndpoint = $"{AppConstants.BASE_URL}HIA3/REST/Authorize?token={jsonToken?.Token}&appCode={AppConstants.APP_CODE}";
                Console.WriteLine(authorizeEndpoint);
                var authorizeResult = await Http.GetAsync(authorizeEndpoint);
                if (authorizeResult.IsSuccessStatusCode) {
                    var authorizeResultContent = await authorizeResult.Content.ReadAsStringAsync();
                    var roles = JsonSerializer.Deserialize<List<string>>(authorizeResultContent);
                    await CookieStorageAccessor.SetValueAsync("roles", JsonSerializer.Serialize(roles));
                    await AuthStateProvider.GetAuthenticationStateAsync();
                    NavigationManager.NavigateTo("/");
                }
            }
        }
    }
}