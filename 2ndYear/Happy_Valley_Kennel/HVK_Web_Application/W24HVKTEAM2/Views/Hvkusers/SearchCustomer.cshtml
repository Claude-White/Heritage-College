@model IEnumerable<W24HVKTEAM2.Models.Hvkuser>

@{
    ViewData["Title"] = "Search Results";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<h1>Search Results</h1>

@if (!Model.Any()) {
    <p>No results found.</p>
} else {
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model) {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        <a asp-action="CustomerDetails" asp-route-id="@user.HvkuserId">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
